{
  "name": "js-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "build:private": "node scripts/build-private.mjs",
    "deploy:private": "npm run build:private && wrangler pages deploy dist-private --project-name js-lab-private"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "acorn": "^8.19.0",
    "fflate": "^0.8.3",
    "jose": "^6.2.15",
    "linkedom": "^0.18.14",
    "lucide-react": "^0.468.0",
    "motion": "^12.0.0",
    "pdfjs-dist": "^6.4.299",
    "prismjs": "^1.29.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-simple-code-editor": "^0.14.1",
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.7.2",
    "vite": "^6.1.0",
    "wrangler": "^4.157.0"
  }
